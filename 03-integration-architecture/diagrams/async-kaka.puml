@startuml
title Integration Architecture — Asynchronous Kafka

skinparam componentStyle rectangle
skinparam shadowing false

participant "Producer Service" as Producer
queue "Kafka Topic" as Kafka
participant "Consumer Service" as Consumer
database "Consumer DB" as DB

Producer -> Kafka : Publish event

Kafka -> Consumer : Deliver event

Consumer -> Consumer : Validate event

alt Valid event
    Consumer -> DB : Apply business effect
    DB --> Consumer : Success
    Consumer -> Kafka : Commit offset

else Processing failure
    Consumer -> Consumer : Retry / error handling
end

@enduml
