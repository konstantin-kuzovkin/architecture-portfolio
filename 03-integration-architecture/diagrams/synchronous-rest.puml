@startuml
title Integration Architecture — Synchronous REST

skinparam componentStyle rectangle
skinparam shadowing false

actor Client

participant "API Gateway" as Gateway
participant "Integration Service" as Integration
participant "REST Service" as Service

Client -> Gateway : HTTP request
Gateway -> Integration : Validate / route

Integration -> Service : REST request

alt Successful response
    Service --> Integration : 2xx + payload
    Integration --> Gateway : Response
    Gateway --> Client : 2xx + payload

else Business error
    Service --> Integration : 4xx + error contract
    Integration --> Gateway : Normalized error
    Gateway --> Client : 4xx

else Technical failure
    Service --> Integration : 5xx / timeout
    Integration --> Gateway : Technical error
    Gateway --> Client : 5xx / controlled error
end

@enduml
