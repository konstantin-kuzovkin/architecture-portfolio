@startuml

title Workflow Platform Migration

actor "Architecture Team" as ARCH
actor "Migration Team" as TEAM

participant "Legacy BPMN\nModels" as BPMN
participant "Legacy Runtime\nState" as STATE
participant "Active Workflow\nInstances" as INST
participant "Custom\nExtensions" as EXT
participant "External\nIntegrations" as INT
participant "History /\nAudit" as AUDIT
participant "Operational\nTooling" as OPS

participant "Target Process\nModels" as TBPMN
participant "Target Runtime\nState" as TSTATE
participant "Target\nIntegrations" as TINT
participant "Target\nOperations" as TOPS

== Discovery ==

ARCH -> BPMN: Analyse process definitions
ARCH -> STATE: Analyse runtime state
ARCH -> INST: Identify active instances
ARCH -> EXT: Analyse custom extensions
ARCH -> INT: Analyse integrations
ARCH -> AUDIT: Analyse history / audit
ARCH -> OPS: Analyse operational capabilities

== Target Architecture ==

ARCH -> TBPMN: Define target process models
ARCH -> TINT: Define target integrations
ARCH -> TOPS: Define target operational model

== Runtime State Migration ==

TEAM -> STATE: Determine state migration strategy
TEAM -> INST: Determine active-instance strategy

alt Compatible runtime state

    STATE -> TSTATE: Migrate runtime state
    INST -> TSTATE: Resume active instances

else State incompatible

    STATE -> TEAM: Transform / convert state
    TEAM -> TSTATE: Create compatible state
    INST -> TEAM: Controlled migration

end

== Process Migration ==

BPMN -> TBPMN: Map / redesign processes

EXT -> TBPMN: Replace or redesign extensions

INT -> TINT: Migrate integrations

AUDIT -> TOPS: Preserve required audit data

OPS -> TOPS: Replace operational tooling

== Validation and Rollout ==

TEAM -> TSTATE: Validate migrated state
TEAM -> TBPMN: Validate process models
TEAM -> TINT: Validate integrations
TEAM -> TOPS: Validate operational tooling

TEAM -> TEAM: Controlled rollout

@enduml
