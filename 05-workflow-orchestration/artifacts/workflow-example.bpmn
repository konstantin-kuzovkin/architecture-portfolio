<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions_TransferWorkflow"
    targetNamespace="http://example.com/architecture-portfolio">

  <bpmn:process
      id="Process_TransferWorkflow"
      name="Transfer Processing Workflow"
      isExecutable="false">

    <bpmn:startEvent
        id="StartEvent_1"
        name="Transfer received"/>

    <bpmn:serviceTask
        id="Task_Validate"
        name="Validate transfer"/>

    <bpmn:serviceTask
        id="Task_Process"
        name="Process transfer"/>

    <bpmn:intermediateCatchEvent
        id="Event_Timeout"
        name="Processing timeout">

      <bpmn:timerEventDefinition/>

    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway
        id="Gateway_Result"
        name="Processing result"/>

    <bpmn:serviceTask
        id="Task_Complete"
        name="Complete operation"/>

    <bpmn:serviceTask
        id="Task_Retry"
        name="Retry processing"/>

    <bpmn:userTask
        id="Task_ManualReview"
        name="Manual review"/>

    <bpmn:serviceTask
        id="Task_Reconcile"
        name="Reconcile external status"/>

    <bpmn:endEvent
        id="EndEvent_Completed"
        name="Completed"/>

    <bpmn:endEvent
        id="EndEvent_Failed"
        name="Failed"/>

    <bpmn:sequenceFlow
        id="Flow_1"
        sourceRef="StartEvent_1"
        targetRef="Task_Validate"/>

    <bpmn:sequenceFlow
        id="Flow_2"
        sourceRef="Task_Validate"
        targetRef="Task_Process"/>

    <bpmn:sequenceFlow
        id="Flow_3"
        sourceRef="Task_Process"
        targetRef="Gateway_Result"/>

    <bpmn:sequenceFlow
        id="Flow_4"
        name="Success"
        sourceRef="Gateway_Result"
        targetRef="Task_Complete"/>

    <bpmn:sequenceFlow
        id="Flow_5"
        name="Technical failure"
        sourceRef="Gateway_Result"
        targetRef="Task_Retry"/>

    <bpmn:sequenceFlow
        id="Flow_6"
        name="Unknown outcome"
        sourceRef="Gateway_Result"
        targetRef="Event_Timeout"/>

    <bpmn:sequenceFlow
        id="Flow_7"
        sourceRef="Event_Timeout"
        targetRef="Task_Reconcile"/>

    <bpmn:sequenceFlow
        id="Flow_8"
        name="Status confirmed"
        sourceRef="Task_Reconcile"
        targetRef="Task_Complete"/>

    <bpmn:sequenceFlow
        id="Flow_9"
        name="Status unresolved"
        sourceRef="Task_Reconcile"
        targetRef="Task_ManualReview"/>

    <bpmn:sequenceFlow
        id="Flow_10"
        sourceRef="Task_Retry"
        targetRef="Task_Process"/>

    <bpmn:sequenceFlow
        id="Flow_11"
        sourceRef="Task_ManualReview"
        targetRef="Task_Reconcile"/>

    <bpmn:sequenceFlow
        id="Flow_12"
        sourceRef="Task_Complete"
        targetRef="EndEvent_Completed"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_TransferWorkflow">

    <bpmndi:BPMNPlane
        id="BPMNPlane_TransferWorkflow"
        bpmnElement="Process_TransferWorkflow">

      <bpmndi:BPMNShape
          id="StartEvent_1_di"
          bpmnElement="StartEvent_1">
        <dc:Bounds x="100" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Task_Validate_di"
          bpmnElement="Task_Validate">
        <dc:Bounds x="180" y="130" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Task_Process_di"
          bpmnElement="Task_Process">
        <dc:Bounds x="350" y="130" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Gateway_Result_di"
          bpmnElement="Gateway_Result"
          isMarkerVisible="true">
        <dc:Bounds x="520" y="145" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Task_Complete_di"
          bpmnElement="Task_Complete">
        <dc:Bounds x="640" y="80" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Task_Retry_di"
          bpmnElement="Task_Retry">
        <dc:Bounds x="640" y="180" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Event_Timeout_di"
          bpmnElement="Event_Timeout">
        <dc:Bounds x="640" y="300" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Task_Reconcile_di"
          bpmnElement="Task_Reconcile">
        <dc:Bounds x="730" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="Task_ManualReview_di"
          bpmnElement="Task_ManualReview">
        <dc:Bounds x="900" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="EndEvent_Completed_di"
          bpmnElement="EndEvent_Completed">
        <dc:Bounds x="830" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
          id="EndEvent_Failed_di"
          bpmnElement="EndEvent_Failed">
        <dc:Bounds x="830" y="220" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="136" y="168"/>
        <di:waypoint x="180" y="168"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="300" y="170"/>
        <di:waypoint x="350" y="170"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="470" y="170"/>
        <di:waypoint x="520" y="170"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="545" y="145"/>
        <di:waypoint x="545" y="120"/>
        <di:waypoint x="640" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="570" y="170"/>
        <di:waypoint x="640" y="220"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="545" y="195"/>
        <di:waypoint x="545" y="318"/>
        <di:waypoint x="640" y="318"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="676" y="318"/>
        <di:waypoint x="730" y="318"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="850" y="300"/>
        <di:waypoint x="850" y="120"/>
        <di:waypoint x="760" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="850" y="340"/>
        <di:waypoint x="900" y="320"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="700" y="180"/>
        <di:waypoint x="700" y="50"/>
        <di:waypoint x="410" y="50"/>
        <di:waypoint x="410" y="130"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="960" y="280"/>
        <di:waypoint x="790" y="280"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="760" y="120"/>
        <di:waypoint x="830" y="118"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
