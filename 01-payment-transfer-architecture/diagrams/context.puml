@startuml
title Payment & Transfer Architecture — System Context
skinparam componentStyle rectangle
skinparam shadowing false
actor "Client Application" as Client
rectangle "Transfer Service" as Transfer {
    component "Transfer API" as API
    component "Operation State" as State
    component "Idempotency" as Idem
}
rectangle "Banking Systems" {
    component "Core Banking / ABS" as ABS
}
rectangle "External Systems" {
    component "Payment Network" as Network
    component "Audit Service" as Audit
}
Client --> API : Create / Get operation
API --> Idem : Check request
API --> State : Create / update state
Transfer --> ABS : Execute transfer
ABS --> Transfer : Result / timeout / error
Transfer --> Network : Payment instruction
Network --> Transfer : Result / timeout / error
Transfer --> Audit : Audit event
State --> API : Current operation status
@enduml
