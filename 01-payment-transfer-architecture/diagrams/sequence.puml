@startuml
title Payment & Transfer — Main Processing Flow
actor Client
participant "Transfer API" as API
database "Operations DB" as DB
participant "Core Banking / ABS" as ABS
participant "Payment Network" as Network
participant "Audit Service" as Audit
Client -> API : Create transfer\n(requestId)
API -> DB : Check idempotency key
alt Request already processed
    DB --> API : Existing operation
    API --> Client : Return current result
else New request
    API -> DB : Create operation\nstatus = NEW
    DB --> API : Operation created
    API -> DB : status = PROCESSING
    API -> ABS : Execute transfer
    alt ABS confirms success
        ABS --> API : SUCCESS
        API -> DB : status = COMPLETED
    else ABS returns business failure
        ABS --> API : DECLINED
        API -> DB : status = DECLINED
    else Timeout / unknown result
        ABS --> API : TIMEOUT / UNKNOWN
        API -> DB : status = UNKNOWN
    end
    API -> Audit : Publish audit event
    API --> Client : Operation status
end
@enduml
