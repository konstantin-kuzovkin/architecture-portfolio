@startuml

title Payment & Transfer — Main Processing Flow

actor Client
participant "Transfer Service" as Transfer
database "Operations DB" as DB
participant "Core Banking / ABS" as ABS
participant "Payment Network" as Network
participant "Audit Service" as Audit

Client -> Transfer : Create transfer\n(requestId)

Transfer -> DB : Check idempotency key

alt Request already processed

    DB --> Transfer : Existing operation
    Transfer --> Client : Return current operation

else New request

    Transfer -> DB : Create operation\nstatus = NEW
    DB --> Transfer : Operation created

    Transfer -> DB : status = PROCESSING

    Transfer -> ABS : Execute transfer

    alt ABS confirms success

        ABS --> Transfer : SUCCESS
        Transfer -> DB : status = COMPLETED

    else ABS returns business failure

        ABS --> Transfer : DECLINED
        Transfer -> DB : status = FAILED

    else Timeout / unknown result

        ABS --> Transfer : TIMEOUT / UNKNOWN
        Transfer -> DB : status = UNKNOWN

    end

    Transfer -> Audit : Publish audit event
    Transfer --> Client : Operation status

end

@enduml
