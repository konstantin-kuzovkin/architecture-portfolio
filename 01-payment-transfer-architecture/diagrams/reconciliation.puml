@startuml
title Payment Transfer - Unknown Result and Reconciliation
participant "Transfer Service" as TS
database "Operations DB" as DB
participant "Payment Network" as PSP
participant "Operations Console" as Ops
TS -> PSP : Submit transfer
PSP --> TS : Accepted
... response timeout ...
TS -> DB : PROCESSING → UNKNOWN
DB --> TS : Committed
TS -> PSP : Query operation status
alt Success confirmed
    PSP --> TS : COMPLETED
    TS -> DB : UNKNOWN → COMPLETED
    DB --> TS : Committed
else Failure confirmed
    PSP --> TS : FAILED
    TS -> DB : UNKNOWN → FAILED
    DB --> TS : Committed
else Status unavailable
    PSP --> TS : UNKNOWN
    TS -> DB : Keep UNKNOWN
    DB --> TS : Committed
    Ops -> TS : Manual investigation
    TS -> PSP : Query status
    PSP --> TS : Final status
    alt Success
        TS -> DB : UNKNOWN → COMPLETED
    else Failure
        TS -> DB : UNKNOWN → FAILED
    end
end
@enduml
