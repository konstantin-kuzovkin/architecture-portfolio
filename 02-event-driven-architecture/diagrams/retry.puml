@startuml

title Kafka Retry and DLQ

queue "Kafka Topic" as Kafka
rectangle "Consumer" as Consumer
rectangle "Retry Flow" as Retry
queue "DLQ" as DLQ
rectangle "Operations" as Ops

Kafka -> Consumer : Event

alt Processing successful
    Consumer -> Kafka : Commit offset
else Temporary failure
    Consumer -> Retry : Retry
    Retry -> Consumer : Redelivery
else Retry exhausted
    Retry -> DLQ : Dead-letter event
    Ops -> DLQ : Investigate / replay
end

@enduml
